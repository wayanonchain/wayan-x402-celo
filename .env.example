# Celo network: testnet (Celo Sepolia) or mainnet
X402_NETWORK=testnet
PORT=8402
PUBLIC_URL=https://agents.wayanwarrior.pro
# Facilitator key: the human creates it at https://x402.celo.org (connect wallet, sign, no gas)
X402_API_KEY=
# Wallet that receives the stablecoin
SELLER_PAY_TO=
# Shared with the Wayan server only: signs the request that turns a paid sale into a redeem code
WAYAN_X402_SECRET=
WAYAN_API_URL=https://wayanwarrior.pro
# Builder attribution tag issued at hackathon enrollment (ERC-8021, appended to every agent transaction)
ATTRIBUTION_TAG=
# ERC-8004 agentId after `npm run register`
AGENT_ID=
